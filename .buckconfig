[cells]
  root = .
  prelude = prelude
  toolchains = toolchains
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

# The prelude is VENDORED (the bundled copy of this buck2 binary, extracted
# verbatim) with one narsil patch: the haskell compile/link actions pass
# allow_cache_upload so they participate in the NativeLink action cache —
# grep 'narsil patch' under prelude/. Worth a PR to facebook/buck2-prelude.

# root//buck/platforms:default is the prelude's default platform, copied (as
# its comment instructs) so the executor can participate in the NativeLink
# action cache when @mode/nativelink flips narsil.remote_cache.
[parser]
  target_platform_detector_spec = target:root//...->root//buck/platforms:default \
    target:prelude//...->root//buck/platforms:default \
    target:toolchains//...->root//buck/platforms:default

[build]
  execution_platforms = root//buck/platforms:default

# narsil notes
# ------------
# Run buck2 inside `nix develop`: the Haskell toolchain (toolchains//BUCK) is
# whatever `ghc` is on PATH, and the devshell's ghc is the flake's
# ghc-with-packages carrying every Hackage dependency. Cabal remains the
# fallback and the Nix/release build path; narsil.cabal is the source of
# truth the BUCK files mirror (see buck/defs.bzl).
#
# NativeLink remote cache/execution: `buck2 build @mode/nativelink //...`
# after pointing mode/nativelink at your deployment.

# NativeLink RE client (straylight: local frontend on :50051, CAS/AC shards
# behind it). Daemon-level: buck2 builds its RE client from HERE, not from
# per-command --config. Harmless when idle — actions only read/write the
# remote cache when the execution platform enables it, i.e. under
# @mode/nativelink (narsil.remote_cache=1).
[buck2_re_client]
  address = grpc://127.0.0.1:50051
  engine_address = grpc://127.0.0.1:50051
  action_cache_address = grpc://127.0.0.1:50051
  cas_address = grpc://127.0.0.1:50051
  instance_name = main
  tls = false
